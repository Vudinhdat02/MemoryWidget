<?xml version="1.0" encoding="utf-8"?>
<!-- Nền kiểu kính (Liquid Glass): lớp mờ + vệt sáng phía trên + ánh sáng mép dưới + viền sáng.
     Launcher không cho widget làm mờ hình nền phía sau nên đây là bản mô phỏng bằng gradient. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@android:dimen/system_app_widget_background_radius" />
            <gradient
                android:angle="270"
                android:endColor="@color/glass_bottom"
                android:startColor="@color/glass_top" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@android:dimen/system_app_widget_background_radius" />
            <gradient
                android:angle="270"
                android:centerColor="@color/glass_clear"
                android:centerY="0.5"
                android:endColor="@color/glass_clear"
                android:startColor="@color/glass_sheen" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@android:dimen/system_app_widget_background_radius" />
            <gradient
                android:angle="270"
                android:centerColor="@color/glass_clear"
                android:centerY="0.65"
                android:endColor="@color/glass_rim"
                android:startColor="@color/glass_clear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@android:dimen/system_app_widget_background_radius" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_edge" />
        </shape>
    </item>
</layer-list>
